{

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection" : "",
    "RedisConnection" : ""
  },
  "FilePaths": {
    "SubmissionFilePath" : ""
  },
  "JWT":{
    "Key":"",
    "Issuer":"",
    "Audience":"",
    "ExpiresIn": 0
  },
  "RabbitMQ":{
    "HostName": "",
    "Port": 0,
    "UserName": "",
    "Password": "",
    "VirtualHost": "/"
  },
  "AllowedHosts": "*"
}
